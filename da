<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D Mini League</title>
    <style>
        body { margin: 0; overflow: hidden; font-family: sans-serif; }
        #scoreboard {
            position: absolute; top: 20px; width: 100%;
            display: flex; justify-content: center;
            gap: 50px; color: white; font-size: 32px; font-weight: bold;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
            pointer-events: none;
        }
        .team-name { font-size: 14px; display: block; text-align: center; }
    </style>
</head>
<body>

    <div id="scoreboard">
        <div><span class="team-name">PLAYER</span><span id="p1-score">0</span></div>
        <div><span class="team-name">ROBOT</span><span id="p2-score">0</span></div>
    </div>

    <script type="importmap">
        {
            "imports": {
                "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
                "cannon-es": "https://unpkg.com/cannon-es@0.20.0/dist/cannon-es.js"
            }
        }
    </script>

    <script type="module">
        import * as THREE from 'three';
        import * as CANNON from 'cannon-es';

        // --- SETUP ---
        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x222222);
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        document.body.appendChild(renderer.domElement);

        const world = new CANNON.World({ gravity: new CANNON.Vec3(0, -9.82, 0) });
        let score = { player: 0, robot: 0 };

        // --- LIGHTING ---
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
        scene.add(ambientLight);
        const sun = new THREE.DirectionalLight(0xffffff, 0.8);
        sun.position.set(10, 20, 10);
        scene.add(sun);

        // --- MATERIALS ---
        const groundMat = new THREE.MeshStandardMaterial({ color: 0x1a472a });
        const ballMat = new THREE.MeshStandardMaterial({ color: 0xffffff });
        const playerMat = new THREE.MeshStandardMaterial({ color: 0x0066ff });
        const robotMat = new THREE.MeshStandardMaterial({ color: 0xff3300 });

        // --- PHYSICS HELPERS ---
        function createBox(w, h, d, mass, pos, mat) {
            const mesh = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
            scene.add(mesh);
            const shape = new CANNON.Box(new CANNON.Vec3(w/2, h/2, d/2));
            const body = new CANNON.Body({ mass, position: new CANNON.Vec3(pos.x, pos.y, pos.z) });
            body.addShape(shape);
            world.addBody(body);
            return { mesh, body };
        }

        // --- GAME OBJECTS ---
        const ground = createBox(40, 1, 60, 0, {x:0, y:-0.5, z:0}, groundMat);
        const ball = {
            mesh: new THREE.Mesh(new THREE.SphereGeometry(0.8, 16, 16), ballMat),
            body: new CANNON.Body({ mass: 1, shape: new CANNON.Sphere(0.8), position: new CANNON.Vec3(0, 5, 0) })
        };
        scene.add(ball.mesh);
        world.addBody(ball.body);

        const player = createBox(2, 1, 3, 5, {x: 0, y: 1, z: 20}, playerMat);
        const robot = createBox(2, 1, 3, 5, {x: 0, y: 1, z: -20}, robotMat);

        // --- INPUTS ---
        const keys = {};
        window.onkeydown = (e) => keys[e.key.toLowerCase()] = true;
        window.onkeyup = (e) => keys[e.key.toLowerCase()] = false;

        // --- RESET LOGIC ---
        function resetPositions() {
            ball.body.position.set(0, 5, 0);
            ball.body.velocity.set(0, 0, 0);
            ball.body.angularVelocity.set(0, 0, 0);

            player.body.position.set(0, 1, 20);
            player.body.velocity.set(0, 0, 0);
            
            robot.body.position.set(0, 1, -20);
            robot.body.velocity.set(0, 0, 0);
        }

        function checkGoals() {
            if (ball.body.position.z > 28) {
                score.robot++;
                document.getElementById('p2-score').innerText = score.robot;
                resetPositions();
            } else if (ball.body.position.z < -28) {
                score.player++;
                document.getElementById('p1-score').innerText = score.player;
                resetPositions();
            }
        }

        // --- GAME LOOP ---
        function update() {
            world.fixedStep();

            // Player Movement
            const force = 30;
            if (keys['w']) player.body.applyForce(new CANNON.Vec3(0, 0, -force), player.body.position);
            if (keys['s']) player.body.applyForce(new CANNON.Vec3(0, 0, force), player.body.position);
            if (keys['a']) player.body.applyForce(new CANNON.Vec3(-force, 0, 0), player.body.position);
            if (keys['d']) player.body.applyForce(new CANNON.Vec3(force, 0, 0), player.body.position);

            // Robot AI (Simple Follow)
            const botDirection = new CANNON.Vec3(
                ball.body.position.x - robot.body.position.x,
                0,
                ball.body.position.z - robot.body.position.z
            );
            botDirection.normalize();
            robot.body.applyForce(botDirection.scale(25), robot.body.position);

            // Sync Meshes
            [player, robot, ball, ground].forEach(obj => {
                obj.mesh.position.copy(obj.body.position);
                obj.mesh.quaternion.copy(obj.body.quaternion);
            });

            // Camera follow
            camera.position.lerp(new THREE.Vector3(player.body.position.x, 10, player.body.position.z + 15), 0.1);
            camera.lookAt(ball.body.position.x, 0, ball.body.position.z);

            checkGoals();
            renderer.render(scene, camera);
            requestAnimationFrame(update);
        }

        window.onresize = () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        };

        update();
    </script>
</body>
</html>
